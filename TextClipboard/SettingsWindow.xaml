<Window x:Class="TextClipboard.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings - Text Clipboard" Width="510" Height="330"
        MinWidth="440" MinHeight="310" MaxHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FontFamily="Tahoma" FontSize="12"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource BodyTextBrush}">
  <Grid Margin="19">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="Quick Paste keyboard shortcut"
               FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>
    <TextBlock Grid.Row="1" Text="Click the field, then press your new shortcut."
               Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,9"/>
    <TextBox x:Name="ShortcutBox" Grid.Row="2" Height="43" Padding="11,9"
             IsReadOnly="True" Cursor="Hand" FontSize="15"
             FontWeight="Bold" HorizontalContentAlignment="Center"
             PreviewKeyDown="ShortcutBox_PreviewKeyDown"
             PreviewMouseLeftButtonDown="ShortcutBox_PreviewMouseLeftButtonDown"/>
    <StackPanel Grid.Row="3" Margin="0,14,0,0">
      <TextBlock x:Name="HintLabel" TextWrapping="Wrap"
                 Foreground="{DynamicResource MutedTextBrush}"
                 Text="Examples: Win + Shift + X, Ctrl + Shift + F8. Ctrl + Alt combinations are blocked to protect AltGr."/>
      <Button Content="Reset to Default" Width="142" Height="30"
              HorizontalAlignment="Left" Margin="0,16,0,0"
              Click="Reset_Click"/>
    </StackPanel>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,10,0,0">
      <Button Content="Cancel" Width="103" Height="33" Margin="0,0,10,0"
              IsCancel="True" Click="Cancel_Click"/>
      <Button Content="Save" Width="103" Height="33" IsDefault="True"
              Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
