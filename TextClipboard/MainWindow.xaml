<Window x:Class="TextClipboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Text Clipboard" Height="665" Width="1030"
        MinHeight="535" MinWidth="800" FontFamily="Tahoma" FontSize="12"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource BodyTextBrush}">
  <Border BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="45"/>
        <RowDefinition Height="31"/>
        <RowDefinition Height="92"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="37"/>
      </Grid.RowDefinitions>

      <!-- Custom XP-inspired title bar -->
      <Border Grid.Row="0" Background="{DynamicResource TitleGradientBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="12,0,8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Foreground="White" FontSize="17"
                     FontWeight="Bold" Text="▤  Text Clipboard"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Width="35" Height="29" Padding="0" Margin="0,0,4,0"
                    ToolTip="Minimize" Content="―" Click="Minimize_Click"/>
            <Button Width="35" Height="29" Padding="0" Margin="0,0,4,0"
                    ToolTip="Maximize / Restore" Content="▢" Click="Maximize_Click"/>
            <Button Width="35" Height="29" Padding="0" Margin="0"
                    ToolTip="Hide to tray" Content="✕" Click="Hide_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Classic menu -->
      <Menu Grid.Row="1" Background="{DynamicResource ButtonBrush}"
            Foreground="{DynamicResource BodyTextBrush}" FontFamily="Tahoma" FontSize="12">
        <MenuItem Header="_File">
          <MenuItem Header="E_xit" Foreground="#202020" Click="FileExit_Click"/>
        </MenuItem>
        <MenuItem Header="_Edit">
          <MenuItem Header="_Clear History" Foreground="#202020" Click="ClearRecent_Click"/>
        </MenuItem>
        <MenuItem x:Name="ThemeMenu" Header="_Theme">
          <MenuItem Header="Olive Classic" Foreground="#202020" Tag="Olive Classic" IsCheckable="True" Click="ThemeMenu_Click"/>
          <MenuItem Header="Luna Blue" Foreground="#202020" Tag="Luna Blue" IsCheckable="True" Click="ThemeMenu_Click"/>
          <MenuItem Header="Silver Frost" Foreground="#202020" Tag="Silver Frost" IsCheckable="True" Click="ThemeMenu_Click"/>
          <MenuItem Header="Classic Gray" Foreground="#202020" Tag="Classic Gray" IsCheckable="True" Click="ThemeMenu_Click"/>
          <MenuItem Header="Night Mode" Foreground="#202020" Tag="Night Mode" IsCheckable="True" Click="ThemeMenu_Click"/>
        </MenuItem>
        <MenuItem Header="_Help">
          <MenuItem Header="_About Text Clipboard" Foreground="#202020" Click="HelpAbout_Click"/>
        </MenuItem>
      </Menu>

      <!-- Branding and hotkey -->
      <Grid Grid.Row="2" Margin="18,9,18,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Text Clipboard" FontSize="25" FontWeight="Bold"/>
          <TextBlock Text="Personal text library" FontSize="13"
                     Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Column="1" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource ButtonBrush}" Padding="15,8"
                VerticalAlignment="Center">
          <StackPanel>
                <TextBlock Text="Win  +  Shift  +  X"
                       FontWeight="Bold" FontSize="15"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Quick paste anywhere" FontSize="11"
                       Foreground="{DynamicResource MutedTextBrush}"/>
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="3" Margin="18,0,18,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <!-- Recent history -->
        <Border Grid.Column="0" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBrush}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="42"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource SectionGradientBrush}"
                    CornerRadius="5,5,0,0" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
              <DockPanel Margin="12,0" VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Left" Text="▤  Recent Copies" FontSize="16" FontWeight="Bold"/>
                <TextBlock x:Name="HistoryCounter" Text="0 / 10" FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </DockPanel>
            </Border>
            <ListBox x:Name="HistoryList" Grid.Row="1" Margin="9,9,9,8"
                     Background="{DynamicResource SurfaceBrush}"
                     Foreground="{DynamicResource BodyTextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                     SelectionChanged="HistoryList_SelectionChanged"
                     PreviewMouseLeftButtonDown="HistoryList_PreviewMouseLeftButtonDown"
                     MouseDoubleClick="HistoryList_MouseDoubleClick"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="5,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="25"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="▤" Foreground="{DynamicResource AccentBrush}" FontSize="17"/>
                    <TextBlock Grid.Column="1" Text="{Binding}" TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Grid.Row="2" Margin="9,0,4,10">
              <Button x:Name="CopyRecentButton" Content="Copy" Click="CopyRecent_Click" IsEnabled="False"/>
              <Button x:Name="SaveRecentButton" Content="Save to Folder" Click="SaveRecent_Click" IsEnabled="False"/>
              <Button x:Name="DeleteRecentButton" Content="Delete" Click="DeleteRecent_Click" IsEnabled="False"/>
              <Button x:Name="ClearRecentButton" Content="Clear History" Click="ClearRecent_Click"/>
            </WrapPanel>
          </Grid>
        </Border>

        <!-- Permanent folders -->
        <Border Grid.Column="2" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBrush}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="42"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource SectionGradientBrush}"
                    CornerRadius="5,5,0,0" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
              <TextBlock Text="📁  My Folders" FontSize="16" FontWeight="Bold"
                         Margin="12,0" VerticalAlignment="Center"/>
            </Border>
            <TreeView x:Name="FoldersTree" Grid.Row="1" Margin="9,9,9,8"
                      Background="{DynamicResource SurfaceBrush}" 
                      Foreground="{DynamicResource BodyTextBrush}"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                      Padding="8" SelectedItemChanged="FoldersTree_SelectedItemChanged"
                      PreviewMouseLeftButtonDown="FoldersTree_PreviewMouseLeftButtonDown"/>
            <StackPanel Grid.Row="2" Margin="9,0,4,8">
              <TextBlock Text="Click the selected entry again to deselect (root level)."
                         FontSize="10" Margin="0,0,0,7"
                         Foreground="{DynamicResource MutedTextBrush}"/>
              <WrapPanel>
                <Button Content="New Folder" Click="AddFolder_Click"/>
                <Button x:Name="AddTextButton" Content="New Text" Click="AddText_Click" IsEnabled="False"/>
                <Button x:Name="EditTreeButton" Content="Edit" Click="EditTree_Click" IsEnabled="False"/>
                <Button x:Name="DeleteTreeButton" Content="Delete" Click="DeleteTree_Click" IsEnabled="False"/>
              </WrapPanel>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="4" BorderThickness="0,1,0,0"
              BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource ButtonBrush}">
        <TextBlock x:Name="StatusLabel" Text="Ready" Margin="14,0"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </Border>
    </Grid>
  </Border>
</Window>
